@using Lorea.Web.Components.Map

<section class="stack-map" aria-labelledby="map-title">
    <h3 id="map-title" class="visually-hidden">@Text["map.title"]</h3>

    <div class="map-frame">
        <div class="map-bar">
            <div class="map-tools">
                @if (CanToggleAddOns)
                {
                    <OSTooltip Text="@Text[Graph.HasFolded ? "map.expand" : "map.collapse"]" Side="TooltipSide.Top">
                        <OSIconButton Class="map-tool"
                                      Icon="@(Graph.HasFolded ? "arrow-down" : "arrow-up")"
                                      Label="@Text[Graph.HasFolded ? "map.expand" : "map.collapse"]"
                                      OnClick="ToggleAddOns" />
                    </OSTooltip>
                }

                <OSTooltip Text="@Text[_fit ? "map.actual" : "map.fit"]" Side="TooltipSide.Top">
                    <OSIconButton Class="map-tool"
                                  Icon="@(_fit ? "minimize" : "maximize")"
                                  Label="@Text[_fit ? "map.actual" : "map.fit"]"
                                  OnClick="ToggleFit" />
                </OSTooltip>

                @if (_selected is not null)
                {
                    <OSTooltip Text="@Text["map.clear"]" Side="TooltipSide.Top">
                        <OSIconButton Class="map-tool"
                                      Icon="close"
                                      Label="@Text["map.clear"]"
                                      OnClick="Clear" />
                    </OSTooltip>
                }
            </div>
        </div>

        @{
            var focus = FocusOf(_hover ?? Active?.Id);
        }
            <div class="map-canvas" data-fit="@(_fit ? "true" : "false")">
                <svg class="map-svg"
                     viewBox="0 0 @F(Layout.Width) @F(Layout.Height)"
                     style="--map-w: @F(Layout.Width)"
                     role="group"
                     aria-label="@Text["map.label"]">
                    @for (var depth = 0; depth < Layout.Levels; depth++)
                    {
                        var rule = F(Layout.RowY(depth) - (MapLayout.RowHeight - MapLayout.NodeHeight) / 2);
                        <line class="map-rule" x1="0" x2="@F(Layout.Width)" y1="@rule" y2="@rule" />
                    }

                    @for (var depth = 0; depth <= Layout.Levels; depth++)
                    {
                        <SvgText Class="map-level"
                                 X="@(Layout.Width - 12)"
                                 Y="@(Layout.RowY(depth) + MapLayout.NodeHeight / 2 + 4)"
                                 TextAnchor="end"
                                 Content="@LevelText(depth)" />
                    }

                    @foreach (var wire in Wires)
                    {
                        <path class="@WireClass(wire, focus)" d="@wire.Path" />
                    }

                    @foreach (var node in Graph.Nodes)
                    {
                        var spot = Layout.Spots[node.Id];
                        <g id="@NodeDomId(node.Id)"
                           class="@NodeClass(node, focus)"
                           tabindex="0"
                           role="button"
                           aria-pressed="@(node.Id == Active?.Id ? "true" : "false")"
                           aria-label="@NodeLabel(node)"
                           @onclick="() => Pick(node.Id)"
                           @onkeydown="e => OnKey(e, node.Id)"
                           @onmouseenter="() => Hover(node.Id)"
                           @onmouseleave="() => Hover(null)"
                           @onfocus="() => Hover(node.Id)"
                           @onblur="() => Hover(null)">
                            <rect class="map-box" x="@F(spot.X - spot.Width / 2)" y="@F(spot.Y)" width="@F(spot.Width)" height="@F(MapLayout.NodeHeight)" rx="2" />
                            <SvgText Class="map-name" X="@spot.X" Y="@(spot.Y + 22)" TextAnchor="middle" Content="@node.Name" />
                            <SvgText Class="map-sub" X="@spot.X" Y="@(spot.Y + 40)" TextAnchor="middle" Content="@TitleOf(node)" />
                        </g>
                    }
                </svg>
            </div>

        <p class="map-swipe">@Text["map.swipe"]</p>

        <ul class="map-legend">
            <li><i class="map-key"></i>@Text["map.legendIdle"]</li>
            <li><i class="map-key is-direct"></i>@Text["map.legendDirect"]</li>
            <li><i class="map-key is-indirect"></i>@Text["map.legendIndirect"]</li>
            <li class="map-legend-note">@Text["map.legendLevel"]</li>
        </ul>

        <div class="map-panel" aria-live="polite">
            @if (Active is not { } current)
            {
                <p class="map-pick">@Text["map.pick"]</p>
            }
            else
            {
                <h3 class="map-panel-title">
                    <code>@current.Name</code>
                    <span>@TitleOf(current)</span>
                </h3>

                @if (current.Entry is { } entry)
                {
                    <p class="map-summary"><OSInlineText Text="@Text[entry.TextKey("summary")]" /></p>
                }
                else
                {
                    <p class="map-summary">@Text["map.familyNote", FamilyOf(current)]</p>
                    <div class="map-rel">
                        <b>@Text["map.members"]</b>
                        @foreach (var member in current.Members)
                        {
                            <OSChip Text="@member.Name" Size="ChipSize.Small" OnClick="() => PickMember(member)" dir="ltr" />
                        }
                    </div>
                }

                <div class="map-rel">
                    <b>@Text["map.relies"]</b>
                    @{
                        var relies = NodesOf(Graph.Down(current.Id));
                    }
                    @foreach (var other in relies)
                    {
                        <OSChip Text="@other.Name" Size="ChipSize.Small" OnClick="() => Pick(other.Id)" dir="ltr" />
                    }
                    @if (relies.Count == 0)
                    {
                        <span class="map-none">@Text["map.reliesNone"]</span>
                    }
                </div>

                <div class="map-rel">
                    <b>@Text["map.builtOn"]</b>
                    @{
                        var builtOn = NodesOf(Graph.Up(current.Id));
                    }
                    @foreach (var other in builtOn)
                    {
                        <OSChip Text="@other.Name" Size="ChipSize.Small" OnClick="() => Pick(other.Id)" dir="ltr" />
                    }
                    @if (builtOn.Count == 0)
                    {
                        <span class="map-none">@Text["map.builtOnNone"]</span>
                    }
                </div>

                @if (current.Entry is { } page)
                {
                    <OSButton Kind="ButtonKind.Key" Href="@PackageUrl(page)">@Text["map.open"]</OSButton>
                }
            }
        </div>
    </div>
</section>
