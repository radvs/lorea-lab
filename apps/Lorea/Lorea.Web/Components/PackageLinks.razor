@if (Items.Count == 0)
{
    <p class="related-none">@Empty</p>
}
else
{
    <ul class="link-list">
        @foreach (var item in Items)
        {
            <li>
                <a href="@($"{Navigation.BaseUri}packages/{item.Slug}")">
                    <code>@item.Name</code>
                    <span>@Text[item.TextKey("title")]</span>
                </a>
            </li>
        }
    </ul>
}
