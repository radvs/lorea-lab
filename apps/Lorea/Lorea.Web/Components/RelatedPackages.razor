@*
    Three groups, always in this order, so a page never ends without a way sideways.
*@

<div class="related">
    <section class="related-group">
        <h2>@Text["related.reliesOn"]</h2>
        <PackageLinks Items="Relies" Empty="@Text["related.reliesNone"]" />
    </section>

    <section class="related-group">
        <h2>@Text["related.builtOn"]</h2>
        <PackageLinks Items="BuiltOn" Empty="@Text["related.builtOnNone"]" />
    </section>

    <section class="related-group">
        <h2>@Text["related.similar"]</h2>
        <PackageLinks Items="Similar" Empty="@Text["related.similarNone"]" />
    </section>
</div>
