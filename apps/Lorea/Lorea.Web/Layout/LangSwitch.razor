<nav class="lorea-lang" aria-label="@Text["layout.languageLabel"]">
    @foreach (var culture in Locale.Cultures.Where(culture => culture.Name != Current.Name))
    {
        <OSTooltip Text="@culture.Culture.Parent.NativeName" Side="TooltipSide.Bottom">
            <OSIconButton Class="language-option"
                          Icon="world"
                          IconSize="20"
                          Label="@culture.Culture.Parent.NativeName"
                          OnClick="() => CultureChanged.InvokeAsync(culture)" />
        </OSTooltip>
    }
</nav>
