@inherits LayoutComponentBase

<div class="lorea" lang="@_culture.Culture.TwoLetterISOLanguageName" dir="@(_culture.IsRightToLeft ? "rtl" : "ltr")">
    <a class="lorea-skip-link" href="#main-content">@Text["layout.skipToMain"]</a>

    <header class="site-head">
        <div class="site-head-inner">
            <a href="@Navigation.BaseUri" class="site-brand" aria-label="@Text["layout.brandLabel"]">
                <svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                    <path d="M16 11V48H53" fill="none" stroke="currentColor" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="16" cy="48" r="9" style="fill:var(--lorea-accent,#0078D4)" />
                </svg>
                <span class="brand-name">@Text["layout.brand"]</span>
                <span class="brand-note">@Text["layout.tagline"]</span>
            </a>

            <div class="header-tools">
                <LangSwitch Current="_culture" CultureChanged="ChangeCulture" />
                <OSThemeToggle LightLabel="@Text["layout.themeLight"]" DarkLabel="@Text["layout.themeDark"]" TooltipSide="TooltipSide.Bottom" />
            </div>
        </div>
    </header>

    <main id="main-content" class="site-main" tabindex="-1">
        <OSBoundary Title="@Text["error.title"]" Text="@Text["error.text"]" RetryLabel="@Text["error.retry"]">
            @* A new language rebuilds the page, so no component keeps the previous language's text. *@
            <CascadingValue Value="_culture" @key="_culture.Name">
                @Body
            </CascadingValue>
        </OSBoundary>
    </main>

    <footer class="site-foot">
        <div class="site-foot-inner">
            <div class="site-foot-brand">
                <a href="@Navigation.BaseUri" class="site-foot-home" aria-label="@Text["layout.brandLabel"]">
                    <svg class="site-foot-mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
                        <path d="M16 11V48H53" fill="none" stroke="currentColor" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" />
                        <circle cx="16" cy="48" r="9" style="fill:var(--lorea-accent,#0078D4)" />
                    </svg>
                    <span>@Text["layout.brand"]</span>
                </a>
                <p class="site-foot-note">@Text["layout.footNote"]</p>
            </div>
            <nav class="site-foot-nav" aria-label="@Text["layout.footNav"]">
                <a href="@($"{Navigation.BaseUri}#packages")">
                    <OSIcon Name="os:list" Size="16" aria-hidden="true" />
                    <span>@Text["nav.packages"]</span>
                </a>
                <a href="@($"{Navigation.BaseUri}#map")">
                    <OSIcon Name="os:tree" Size="16" aria-hidden="true" />
                    <span>@Text["nav.map"]</span>
                </a>
            </nav>
        </div>
    </footer>

    <OSToTop Label="@Text["layout.toTop"]" />
    <OSConnectionWatch />
    <OSToastHost DismissLabel="@Text["layout.dismiss"]" />
</div>
