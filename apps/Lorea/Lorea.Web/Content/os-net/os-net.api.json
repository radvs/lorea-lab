  "samples": [
    {
      "key": "normalize",
      "code": "var result = MailEx.Normalize(\"John.Doe+news@GoogleMail.com\");",
      "topic": "mail",
      "output": "True\njohndoe@gmail.com\ngmail.com\nPersonal"
    },
    {
      "key": "options",
      "code": "var tagged = MailEx.Normalize(\"A.B+x@outlook.com\", new MailOptions { RemoveTags = false });\nvar plain = MailEx.Normalize(\"A.B+x@outlook.com\");",
      "topic": "mail",
      "output": "a.b+x@outlook.com\na.b@outlook.com"
    },
    {
      "key": "mask",
      "code": "var result = MailEx.Normalize(\"radman@mail-corp.example\");",
      "topic": "mail",
      "output": "r****n@mail-corp.example\nCorporate"
    },
    {
      "key": "invalid",
      "code": "var result = MailEx.Normalize(\"not-an-email\");",
      "topic": "mail",
      "output": "False\nInvalid\nnet.mail.invalid"
    },
    {
      "key": "link-key",
      "code": "var same = UrlEx.AreSame(\"https://www.Example.com/shop/?utm_source=ad\", \"example.com/shop\");",
      "output": "True"
    },
    {
      "key": "mail-key",
      "code": "var key = MailEx.Normalize(\"John.Doe+news@googlemail.com\").Data!.Key;",
      "output": "johndoe@gmail.com"
    },
    {
      "key": "check",
      "code": "var plain = UrlEx.IsUrl(\"https://example.com/a\");\nvar ftp = UrlEx.IsUrl(\"ftp://example.com\");\nvar withLogin = UrlEx.IsUrl(\"https://user:pw@example.com\");",
      "topic": "urls",
      "output": "True\nFalse\nFalse"
    },
    {
      "key": "normalize",
      "code": "var typed = UrlEx.TryNormalize(\"  example.com/page \", out var url);\nvar script = UrlEx.TryNormalize(\"javascript://alert(1)\", out _);",
      "topic": "urls",
      "output": "True\nhttps://example.com/page\nFalse"
    },
    {
      "key": "query",
      "code": "var added = UrlEx.WithQuery(\"https://shop.example/p?id=7#reviews\", [new(\"page\", \"2\"), new(\"q\", \"a&b=c\")]);\nvar cleaned = UrlEx.WithoutQuery(\"https://shop.example/p?utm_source=ad&id=7\", UrlEx.TrackingKeys);",
      "topic": "urls",
      "output": "https://shop.example/p?id=7&page=2&q=a%26b%3Dc#reviews\nhttps://shop.example/p?id=7"
    },
    {
      "key": "parse",
      "code": "UrlInfo.TryParse(\"Shop.Example.com/p?id=7&utm_source=ad\", out var info);",
      "topic": "urls",
      "output": "https://shop.example.com/p?id=7&utm_source=ad\nshop.example.com\n/p\nid=7&utm_source=ad\n64"
    },
    {
      "key": "same-link",
      "code": "var same = UrlEx.AreSame(\"https://www.Example.com/Shop/?utm_source=ad\", \"example.com/shop\");\nvar key = UrlEx.Key(\"https://example.com/shop\");",
      "topic": "urls",
      "output": "True\n64"
    },
    {
      "key": "readable",
      "code": "var shown = UrlEx.Readable(\"https://example.com/%D8%B3%D9%84%D8%A7%D9%85?q=a%20b\");\nUrlEx.TryGetFileName(\"https://example.com/files/report%20final.pdf\", includeExtension: false, out var name);",
      "topic": "urls",
      "output": "https://example.com/سلام?q=a%20b\nreport final"
    },
    {
      "key": "token",
      "code": "var token = UrlToken.Normalize(\"  My1 \");\nvar wellFormed = UrlToken.IsWellFormed(\"my-1\");\nvar reserved = UrlToken.IsReserved(\"API\");\nvar custom = UrlToken.IsReserved(\"shop\", [\"shop\"]);",
      "topic": "urls",
      "output": "my1\nFalse\nTrue\nTrue"
    },
    {
      "key": "platform",
      "code": "var video = UrlPlatform.Detect(\"https://www.youtube.com/watch?v=1\");\nvar unknown = UrlPlatform.Detect(\"https://example.com\");\nvar own = UrlPlatform.Detect(\"https://shop.example/x\", new Dictionary<string, string> { [\"shop.example\"] = \"shop\" });",
      "topic": "urls",
      "output": "youtube\nnull\nshop"
    },
    {
      "key": "status",
      "code": "var missing = UrlEx.StatusOf(HttpStatusCode.NotFound);\nvar gone = UrlEx.StatusOf(HttpStatusCode.Gone);\nvar moved = UrlEx.StatusOf(HttpStatusCode.MovedPermanently);\nvar down = UrlEx.StatusOf(HttpStatusCode.ServiceUnavailable);",
      "topic": "urls",
      "output": "NotFound\nNotFound\nRedirected\nFailed"
    }
  ]
