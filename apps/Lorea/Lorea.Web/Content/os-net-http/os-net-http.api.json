  "samples": [
    {
      "key": "get",
      "code": "var api = http.Create(\"shop\");\n\nvar result = await api.GetAsync<Product>(\"products/7\", token);",
      "topic": "calls"
    },
    {
      "key": "post",
      "code": "var api = http.Create(\"shop\");\n\nvar result = await api.PostAsync(\"orders\", new Order(7, 2), token);",
      "topic": "calls"
    },
    {
      "key": "fetch",
      "code": "var page = await http.Create(\"shop\").FetchAsync(\"products/7\", token);\n\nif (!page.Succeeded)\n    return page.Code!;",
      "topic": "calls"
    },
    {
      "key": "status",
      "code": "var missing = ResultEx.FromHttpStatus(404);\nvar busy = ResultEx.FromHttpStatus(429);\nvar rejected = ResultEx.FromHttpStatus(422);\nvar broken = ResultEx.FromHttpStatus(500);",
      "topic": "calls",
      "output": "NotFound\nUnavailable\nFailed\nError\nhttp.404"
    },
    {
      "key": "config",
      "code": "var config = JsonSerializer.Deserialize<ApiConfig>(\"\"\"\n    {\n      \"name\": \"shop\",\n      \"base-url\": \"https://api.example.com\",\n      \"timeout\": \"00:00:20\",\n      \"headers\": [ { \"type\": \"BearerAuth\", \"value\": \"secret-token\" } ]\n    }\n    \"\"\")!;",
      "topic": "clients",
      "output": "shop\n00:00:20\n3\nBearerAuth"
    },
    {
      "key": "headers",
      "code": "services.AddOSHttp(new ApiConfig\n{\n    Name = \"sms\",\n    BaseUrl = \"https://sms.example.com/api\",\n    Headers =\n    [\n        new() { Type = ApiHeaderType.BasicAuth, User = \"account\", Password = \"secret\" },\n        new() { Type = ApiHeaderType.Accept, Value = \"application/json\" },\n        new() { Type = ApiHeaderType.ApiVersion, Value = \"2\" }\n    ]\n});",
      "topic": "clients"
    },
    {
      "key": "register",
      "code": "services.AddOSHttp(configs);",
      "topic": "clients"
    },
    {
      "key": "register",
      "code": "services.AddOSHttp(new ApiConfig\n{\n    Name = \"shop\",\n    BaseUrl = \"https://api.example.com\",\n    Timeout = TimeSpan.FromSeconds(10)\n});"
    },
    {
      "key": "call",
      "code": "var result = await http.Create(\"shop\").GetAsync<Product>(\"products/7\", token);"
    },
    {
      "key": "safe-fetch",
      "code": "var page = await http.Create(\"preview\").FetchAsync(userLink, token);"
    },
    {
      "key": "configure",
      "code": "services.AddOSHttp(new ApiConfig\n{\n    Name = \"shop\",\n    BaseUrl = \"https://api.example.com\",\n    Timeout = TimeSpan.FromSeconds(8),\n    Retries = 2,\n    PermitLimit = 20,\n    QueueLimit = 50\n});",
      "topic": "resilience"
    },
    {
      "key": "no-retries",
      "code": "services.AddOSHttp(new ApiConfig { Name = \"payments\", BaseUrl = \"https://pay.example.com\", Retries = 0 });",
      "topic": "resilience"
    },
    {
      "key": "addresses",
      "code": "var web = AddressRules.IsPublic(IPAddress.Parse(\"8.8.8.8\"));\nvar office = AddressRules.IsPublic(IPAddress.Parse(\"10.0.0.5\"));\nvar metadata = AddressRules.IsPublic(IPAddress.Parse(\"169.254.169.254\"));\nvar loopback = AddressRules.IsPublic(IPAddress.IPv6Loopback);",
      "topic": "safety",
      "output": "True\nFalse\nFalse\nFalse"
    },
    {
      "key": "enable",
      "code": "services.AddOSHttp(new ApiConfig { Name = \"preview\", Safe = true, MaxBytes = 2 * 1024 * 1024 });\n\nvar page = await http.Create(\"preview\").FetchAsync(userLink, token);",
      "topic": "safety"
    }
  ]
