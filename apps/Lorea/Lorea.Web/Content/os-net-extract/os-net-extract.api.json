  "samples": [
    {
      "key": "read",
      "code": "using var provider = new ServiceCollection().AddOSExtract(new ExtractConfig()).BuildServiceProvider();\nusing var doc = Open(provider);\n\nvar title = ExtractEx.Read(doc, new ExtractField { Name = \"title\", Selectors = [\"h1\"] });\nvar link = ExtractEx.Read(doc, new ExtractField { Name = \"link\", Selectors = [\"a.buy\"], Attribute = \"href\", Absolute = true }, \"https://shop.example/items/\");",
      "topic": "html",
      "output": "Blue pen\nhttps://shop.example/cart/7"
    },
    {
      "key": "fallback",
      "code": "using var provider = new ServiceCollection().AddOSExtract(new ExtractConfig()).BuildServiceProvider();\nusing var doc = Open(provider);\n\nvar field = new ExtractField { Name = \"title\", Selectors = [\"h1.product\", \"h2\", \"h1\"] };\nvar value = ExtractEx.Read(doc, field).Data!;",
      "topic": "html",
      "output": "Blue pen\nh1"
    },
    {
      "key": "texts",
      "code": "using var provider = new ServiceCollection().AddOSExtract(new ExtractConfig()).BuildServiceProvider();\nusing var doc = Open(provider);\n\nvar all = ExtractEx.Texts(doc, \"li\").Data!;\nvar second = ExtractEx.Read(doc, new ExtractField { Name = \"size\", Selectors = [\"li\"], Index = 1 });",
      "topic": "html",
      "output": "fine, 0.5 mm, blue\n0.5 mm"
    },
    {
      "key": "miss",
      "code": "using var provider = new ServiceCollection().AddOSExtract(new ExtractConfig()).BuildServiceProvider();\nusing var doc = Open(provider);\n\nvar result = ExtractEx.Read(doc, new ExtractField { Name = \"price\", Selectors = [\".price\"] });",
      "topic": "html",
      "output": "False\nNotFound\nextract.miss"
    },
    {
      "key": "path",
      "code": "using var json = JsonDocument.Parse(\"\"\"{\"data\":{\"items\":[{\"price\":10},{\"price\":20,\"name\":\"Pen\"}]}}\"\"\");\n\nvar price = ExtractEx.ReadJson(json.RootElement, new ExtractField { Name = \"price\", Paths = [\"data.items[1].price\"] });\nvar fallback = ExtractEx.ReadJson(json.RootElement, new ExtractField { Name = \"name\", Paths = [\"data.title\", \"data.items[1].name\"] });",
      "topic": "json",
      "output": "20\nPen\ndata.items[1].name"
    },
    {
      "key": "script-tag",
      "code": "using var provider = new ServiceCollection().AddOSExtract(new ExtractConfig()).BuildServiceProvider();\nusing var doc = provider.GetRequiredService<IExtractEngine>().Parse(\"\"\"\n    <html><head><script type=\"application/ld+json\">{\"name\":\"Blue pen\",\"offers\":{\"price\":\"12.5\"}}</script></head></html>\n    \"\"\").Data!;\n\nvar script = ExtractEx.FromScriptTag(doc, \"application/ld+json\").Data!;\nusing var json = JsonDocument.Parse(script);\n\nvar price = ExtractEx.ReadJson(json.RootElement, new ExtractField { Name = \"price\", Paths = [\"offers.price\"] });",
      "topic": "json",
      "output": "12.5"
    },
    {
      "key": "quick",
      "code": "var service = factory.GetServiceByHost(new Uri(link).Host).Data!;\n\nvar result = await service.SendAsync(new ExtractRequest { Url = link }, token);"
    },
    {
      "key": "config",
      "code": "var config = JsonSerializer.Deserialize<ExtractConfig>(\"\"\"\n    {\n      \"user-agent\": \"MyApp/1.0\",\n      \"providers\": [\n        {\n          \"name\": \"shop\",\n          \"host\": \"shop.example\",\n          \"format\": \"Html\",\n          \"fields\": [\n            { \"name\": \"title\", \"selectors\": [ \"h1.product\", \"h1\" ] },\n            { \"name\": \"image\", \"selectors\": [ \"meta[property='og:image']\" ], \"attribute\": \"content\", \"absolute\": true }\n          ]\n        }\n      ]\n    }\n    \"\"\")!;\n\nvar provider = config.Providers[0];",
      "topic": "providers",
      "output": "shop\nHtml\n2\nh1.product"
    },
    {
      "key": "register",
      "code": "services.AddOSExtract(configuration);",
      "topic": "providers"
    },
    {
      "key": "merge",
      "code": "services.AddOSExtract(shops);\nservices.AddOSExtract(news);",
      "topic": "providers"
    },
    {
      "key": "send",
      "code": "var service = factory.GetService(\"shop\").Data!;\n\nvar result = await service.SendAsync(new ExtractRequest { Provider = \"shop\", Url = link }, token);\n\nvar page = result.Data!;",
      "topic": "service"
    },
    {
      "key": "bulk",
      "code": "var service = factory.GetService(\"shop\").Data!;\n\nvar requests = links.Select(link => new ExtractRequest { Provider = \"shop\", Url = link }).ToList();\nvar results = await service.SendBulkAsync(requests, token);",
      "topic": "service"
    },
    {
      "key": "by-host",
      "code": "var service = factory.GetServiceByHost(new Uri(link).Host).Data!;\n\nvar result = await service.SendAsync(new ExtractRequest { Url = link, Html = html }, token);",
      "topic": "service"
    }
  ]
}