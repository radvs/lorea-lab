  "samples": [
    {
      "key": "numbers",
      "code": "var persian = new PersianCultureProfile();\nvar price = persian.FormatNumber(1234567.891m);\nvar debt = persian.FormatMoney(-250000, \"ریال\");\nvar room = persian.ToNativeDigits(\"Room 12\");",
      "topic": "culture",
      "output": "۱٬۲۳۴٬۵۶۷٫۸۹\n‎−۲۵۰٬۰۰۰ ریال\nRoom ۱۲"
    },
    {
      "key": "words",
      "code": "var persian = new PersianCultureProfile();\nvar year = persian.ToWords(1404);\nvar third = persian.ToOrdinalWords(3);\nvar english = new EnglishCultureProfile().ToWords(1404);",
      "topic": "culture",
      "output": "یک‌هزار و چهارصد و چهار\nسوم\none thousand four hundred four"
    },
    {
      "key": "dates",
      "code": "var date = new DateOnly(2024, 10, 12);\nvar persian = new PersianCultureProfile().FormatDate(date, DateStyle.Full);\nvar english = new EnglishCultureProfile().FormatDate(date, DateStyle.Full);\nvar custom = new PersianCultureProfile().FormatDate(date, \"yyyy-MM-dd\");",
      "topic": "culture",
      "output": "شنبه ۲۱ مهر ۱۴۰۳\nSaturday, October 12, 2024\n۱۴۰۳-۰۷-۲۱"
    },
    {
      "key": "parse",
      "code": "var persian = new PersianCultureProfile();\nvar ok = persian.TryParseDate(\"۱۴۰۳/۷/۲۱\", out var date);\nvar strict = persian.TryParseDate(\"۱۴۰۳/۷/۲۱\", out _, strict: true);",
      "topic": "culture",
      "output": "True\n10/12/2024\nFalse"
    },
    {
      "key": "normalize",
      "code": "var name = new PersianCultureProfile().NormalizeText(\"  علي   كريمي \");",
      "topic": "culture",
      "output": "علی کریمی"
    },
    {
      "key": "periods",
      "code": "var persian = new PersianCultureProfile();\nvar date = new DateOnly(2024, 10, 12);\nvar month = persian.FormatDate(persian.StartOfMonth(date), DateStyle.Long);\nvar year = persian.FormatDate(persian.StartOfYear(date), DateStyle.Long);",
      "topic": "culture",
      "output": "۱ مهر ۱۴۰۳\n۱ فروردین ۱۴۰۳"
    },
    {
      "key": "words",
      "code": "var words = new PersianCultureProfile().ToWords(1404);",
      "output": "یک‌هزار و چهارصد و چهار"
    },
    {
      "key": "date",
      "code": "var nowruz = new PersianCultureProfile().FormatDate(new DateOnly(2025, 3, 21), DateStyle.Long);",
      "output": "۱ فروردین ۱۴۰۴"
    },
    {
      "key": "phone",
      "code": "var iran = new IranRegionProfile();\niran.TryNormalizeMobile(\"۰۹۱۲ ۱۲۳ ۴۵۶۷\", out var mobile);\niran.TryFormatNational(mobile, out var national);",
      "topic": "region",
      "output": "+989121234567\n09121234567"
    },
    {
      "key": "national-id",
      "code": "var iran = new IranRegionProfile();\nvar valid = iran.TryNormalizeNationalId(\"123456789\", out var id);\nvar wrong = iran.TryNormalizeNationalId(\"1111111111\", out _);",
      "topic": "region",
      "output": "True\n0123456789\nFalse"
    },
    {
      "key": "week",
      "code": "var iran = new IranRegionProfile();\nvar first = iran.FirstDayOfWeek;\nvar friday = iran.IsWeekend(DayOfWeek.Friday);\nvar tehran = iran.ToRegionTime(new DateTime(2024, 10, 12, 12, 0, 0, DateTimeKind.Utc));",
      "topic": "region",
      "output": "Saturday\nTrue\n10/12/2024 15:30:00"
    },
    {
      "key": "currency",
      "code": "var iran = new IranRegionProfile();\nvar (rial, toman) = (iran.CurrencyUnits[0], iran.CurrencyUnits[1]);\nvar amount = iran.ConvertCurrency(250000, rial, toman);\nvar name = toman.GetName(CultureInfo.GetCultureInfo(\"fa-IR\"));",
      "topic": "region",
      "output": "25000\nتومان"
    },
    {
      "key": "divisions",
      "code": "var iran = new IranRegionProfile();\nvar persian = CultureInfo.GetCultureInfo(\"fa-IR\");\nvar provinces = iran.GetDivisions().Count;\nvar found = iran.SearchDivisions(\"كرمان\", persian).Where(division => division.Level == 1).Select(division => division.GetName(persian));",
      "topic": "region",
      "output": "31\nکرمان, کرمانشاه"
    },
    {
      "key": "register",
      "code": "services.AddOSLocale(options =>\n{\n    options.DefaultCulture = CultureNames.English;\n    options.Text.AddEmbedded(typeof(SetupSamples).Assembly, \"Texts\");\n});",
      "topic": "setup"
    },
    {
      "key": "lookup",
      "code": "var registry = new ServiceCollection().AddOSLocale().BuildServiceProvider().GetRequiredService<ILocaleRegistry>();\nvar persian = registry.GetCulture(\"fa\");\nvar typo = registry.TryGetCulture(\"fe-IR\", out _);\nvar iran = registry.Get<IranRegionProfile>();",
      "topic": "setup",
      "output": "fa-IR\nFalse\nIR"
    },
    {
      "key": "custom",
      "code": "public sealed class GermanCultureProfile() : CultureProfile(\"de-DE\");\n\npublic static void AddGerman(IServiceCollection services) =>\n    services.AddOSLocale(options => options\n        .AddCulture<PersianCultureProfile>()\n        .AddCulture<EnglishCultureProfile>()\n        .AddCulture<GermanCultureProfile>());",
      "topic": "setup"
    },
    {
      "key": "model",
      "code": "public sealed record Order(string Customer, decimal Total, DateOnly Date);",
      "topic": "templates"
    },
    {
      "key": "render",
      "code": "var templates = new ServiceCollection().AddOSLocale().BuildServiceProvider().GetRequiredService<ITemplateRenderer>();\nvar order = new Order(\"Sara\", 1250000m, new DateOnly(2024, 10, 12));\nvar text = templates.Render(\"{Customer|upper}: {Total} ریال، {Date|format(\\\"d MMMM yyyy\\\")}\", order);",
      "topic": "templates",
      "output": "SARA: ۱٬۲۵۰٬۰۰۰ ریال، ۲۱ مهر ۱۴۰۳"
    },
    {
      "key": "globals",
      "code": "var templates = new ServiceCollection()\n    .AddOSLocale(options => options.Templates.AddGlobal(\"Site\", new { Title = \"Lorea\" }))\n    .BuildServiceProvider()\n    .GetRequiredService<ITemplateRenderer>();\nvar text = templates.Render(\"{@Site.Title|upper} {{docs}}\");",
      "topic": "templates",
      "output": "LOREA {docs}"
    },
    {
      "key": "filter",
      "code": "public sealed class MaskFilter : ITemplateFilter\n{\n    public string Name => \"mask\";\n\n    public object? Apply(object? value, IReadOnlyList<string> arguments, TemplateContext context) =>\n        Mask.Apply(value?.ToString());\n}",
      "topic": "templates"
    },
    {
      "key": "custom",
      "code": "var templates = new ServiceCollection()\n    .AddOSLocale(options => options.Templates.AddFilter<MaskFilter>())\n    .BuildServiceProvider()\n    .GetRequiredService<ITemplateRenderer>();\nvar text = templates.Render(\"{Card|mask}\", new { Card = \"6037991234567890\" });",
      "topic": "templates",
      "output": "••••••••••••7890"
    },
