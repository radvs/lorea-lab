  "samples": [
    {
      "key": "fingerprint",
      "code": "var stack = \"   at Shop.Orders.OrderService.Save(Order order) in C:\\\\shop\\\\OrderService.cs:line \";\n\nvar monday = ErrorFingerprint.Of(Report(\"System.InvalidOperationException\", stack + \"42\"));\nvar tuesday = ErrorFingerprint.Of(Report(\"System.InvalidOperationException\", stack + \"57\"));\nvar other = ErrorFingerprint.Of(Report(\"System.ArgumentException\", stack + \"42\"));",
      "topic": "ledger",
      "output": "True\nFalse\n16"
    },
    {
      "key": "rate-limit",
      "code": "var clock = new FakeTimeProvider();\nvar ledger = new ErrorLedger(new DiagnosticsOptions { AppCode = \"shop\", PerFingerprintPerMinute = 2 }, clock);\nvar report = Report(\"System.TimeoutException\");\n\nvar first = ledger.TryReport(report);\nvar second = ledger.TryReport(report);\nvar third = ledger.TryReport(report);\n\nclock.Advance(TimeSpan.FromMinutes(1));\nvar nextMinute = ledger.TryReport(report);",
      "topic": "ledger",
      "output": "True\nTrue\nFalse\nTrue"
    },
    {
      "key": "dropped",
      "code": "var ledger = new ErrorLedger(new DiagnosticsOptions { AppCode = \"shop\", QueueSize = 1 }, TimeProvider.System);\n\nvar queued = ledger.TryReport(Report(\"System.TimeoutException\"));\nvar full = ledger.TryReport(Report(\"System.IO.IOException\"));",
      "topic": "ledger",
      "output": "True\nFalse\n1"
    },
    {
      "key": "quick",
      "code": "sink.TryReport(ErrorReport.From(error));"
    },
    {
      "key": "from-exception",
      "code": "var report = ErrorReport.From(Failure()) with { Method = \"POST\", Route = \"/orders\", StatusCode = 500 };",
      "topic": "report",
      "output": "System.InvalidOperationException\nThe stock is empty.\nPOST\n/orders"
    },
    {
      "key": "send",
      "code": "sink.TryReport(ErrorReport.From(error) with { Method = \"POST\", Route = \"/orders\", StatusCode = 500, UserId = 7 });",
      "topic": "report"
    },
    {
      "key": "hook",
      "code": "public sealed record OrderPlaced(int Id);\n\npublic sealed class AuditHook : IHook<OrderPlaced>\n{\n    public HookFailure OnFailure => HookFailure.Log;\n\n    public ValueTask HandleAsync(OrderPlaced e, CancellationToken token = default) =>\n        throw new InvalidOperationException(\"The audit store is down.\");\n}",
      "topic": "report"
    },
    {
      "key": "register-hook",
      "code": "services.AddSingleton<IErrorStore, StoreSamples.MemoryStore>();\nservices.AddOSDiagnostics(o => o.AppCode = \"shop\");\nservices.AddOSHook<OrderPlaced, AuditHook>();",
      "topic": "report"
    },
    {
      "key": "register",
      "code": "services.AddSingleton<IErrorStore, StoreSamples.MemoryStore>();\nservices.AddOSDiagnostics(o => o.AppCode = \"shop\");",
      "topic": "setup"
    },
    {
      "key": "configure",
      "code": "services.AddOSDiagnostics(o =>\n{\n    o.AppCode = \"shop\";\n    o.PerFingerprintPerMinute = 2;\n    o.FlushEvery = TimeSpan.FromSeconds(5);\n    o.MaxStack = 4 * 1024;\n});",
      "topic": "setup"
    },
    {
      "key": "defaults",
      "code": "var options = new DiagnosticsOptions();",
      "topic": "setup",
      "output": "512\n50\n00:00:02\n5\n8192"
    },
    {
      "key": "write-batch",
      "code": "public sealed class MemoryStore : IErrorStore\n{\n    private readonly List<ErrorRecord> _records = [];\n\n    public Task WriteAsync(IReadOnlyList<ErrorRecord> records, CancellationToken token = default)\n    {\n        lock (_records)\n            _records.AddRange(records);\n\n        return Task.CompletedTask;\n    }\n}",
      "topic": "store"
    },
    {
      "key": "last-day",
      "code": "var result = await reader.IssuesAsync(new ErrorFilter { Hours = 24 }, token);",
      "topic": "store"
    },
    {
      "key": "open",
      "code": "var found = await reader.FindAsync(traceId, token);",
