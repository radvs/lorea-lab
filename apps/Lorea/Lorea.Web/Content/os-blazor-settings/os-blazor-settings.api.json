    {
      "key": "own-route",
      "code": "services.AddOSBlazorSettings(options => options.Root = \"api/admin/settings\");",
      "topic": "start"
    },
    {
      "key": "texts-after-blazor",
      "code": "services.AddOSBlazor(options =>\n    options.Locale.Text.AddEmbedded(typeof(SettingsUiOptions).Assembly));\n\nservices.AddOSBlazorSettings();",
      "topic": "start"
    },
    {
      "key": "routes",
      "code": "Demo.Run(async demo =>\n{\n    await demo.Client.GetSectionsAsync(Scope.App);\n    await demo.Client.GetSectionAsync(\"mail\", new Scope(1, 5));\n    await demo.Client.SaveAsync(new SettingSaveModel { Section = \"mail\", Scope = new Scope(1, 5) });\n\n    return demo.Calls.Cast<object>().ToArray();\n});",
      "topic": "start",
      "output": "GET /settings/sections?kind=0&id=0\nGET /settings/sections/mail?kind=1&id=5\nPOST /settings/sections/mail"
    },
    {
      "key": "values",
      "code": "Demo.Run(demo =>\n{\n    var text = demo.Text;\n\n    var timeout = new SettingItemModel { Key = \"mail.timeout\", Kind = SettingCodes.Kind.Duration };\n    var enabled = new SettingItemModel { Key = \"mail.enabled\", Kind = SettingCodes.Kind.Boolean };\n    var secret = new SettingItemModel { Key = \"mail.password\", Kind = SettingCodes.Kind.Text, Access = SettingAccess.Secret, HasSecret = true };\n\n    object[] values =\n    [\n        $\"duration: {text.Format(timeout, \"02:00:00\")}\",\n        $\"boolean: {text.Format(enabled, \"true\")}\",\n        $\"secret: {text.Format(secret, \"ignored\")}\",\n        $\"no value: {text.Format(enabled, null)}\",\n        $\"size: {text.Bytes(3_500_000)}\"\n    ];\n\n    return Task.FromResult(values);\n});",
      "topic": "texts",
      "output": "duration: 2 hours\nboolean: On\nsecret: ••••••••\nno value: Whole-app value\nsize: 3.3 MB"
    },
    {
      "key": "own-keys",
