  "samples": [
    {
      "key": "faults",
      "code": "[\n    $\"port 'abc': {SettingCheck.Check(Item(SettingCodes.Kind.Integer), \"abc\")}\",\n    $\"port 99999 of 1-65535: {SettingCheck.Check(Item(SettingCodes.Kind.Integer, new SettingRules { Min = 1, Max = 65535 }), \"99999\")}\",\n    $\"address 'ftp://x': {SettingCheck.Check(Item(SettingCodes.Kind.Url), \"ftp://x\")}\",\n    $\"path '/a/../b': {SettingCheck.Check(Item(SettingCodes.Kind.Path), \"/a/../b\")}\",\n    $\"port 587: {SettingCheck.Check(Item(SettingCodes.Kind.Integer), \"587\") ?? \"valid\"}\"\n];",
      "topic": "checking",
      "output": "port 'abc': settings.errors.integer\nport 99999 of 1-65535: settings.errors.range\naddress 'ftp://x': settings.errors.url\npath '/a/../b': settings.errors.path\nport 587: valid"
    },
    {
      "key": "persian-digits",
      "code": "[\n    $\"latin: {SettingCheck.Latin(\"۱۲٫۵\")}\",\n    $\"valid port: {SettingCheck.Check(Item(SettingCodes.Kind.Integer), \"۵۸۷\") ?? \"valid\"}\",\n    $\"text stays: {SettingCheck.Check(Item(SettingCodes.Kind.Text), \"۵۸۷\") ?? \"valid\"}\"\n];",
      "topic": "checking",
      "output": "latin: 12.5\nvalid port: valid\ntext stays: valid"
    },
    {
      "key": "durations",
      "code": "[\n    $\"seconds to text: {SettingCheck.Duration(5400)}\",\n    $\"text to span: {(SettingCheck.TryDuration(\"01:30:00\", out var span) ? span.ToString() : \"invalid\")}\",\n    $\"bare number: {SettingCheck.Check(Item(SettingCodes.Kind.Duration), \"90\")}\"\n];",
      "topic": "checking",
      "output": "seconds to text: 01:30:00\ntext to span: 01:30:00\nbare number: settings.errors.duration"
    },
    {
      "key": "draft",
      "code": "var desk = new SettingDesk(Mail(Scope.App));\n\ndesk.Set(\"mail.port\", \"587\");\ndesk.Set(\"mail.host\", \"smtp.example.com\");\n\nvar save = desk.ToSave();",
      "topic": "editing",
      "output": "dirty: 1\nsaved key: mail.port\nsaved value: 587"
    },
    {
      "key": "fault",
      "code": "var desk = new SettingDesk(Mail(Scope.App));\n\ndesk.Set(\"mail.port\", \"abc\");",
      "topic": "editing",
      "output": "faults: 1\nerror key: settings.errors.integer"
    },
    {
      "key": "reset",
      "code": "var app = new SettingDesk(Mail(Scope.App));\nvar shop = new SettingDesk(Mail(new Scope(1, 5)));\n\napp.Reset(\"mail.host\");\nshop.Reset(\"mail.host\");",
      "topic": "editing",
      "output": "app shows: localhost\nscope shows: null (follows the app)\nreset sent: True"
    },
    {
      "key": "conflict",
      "code": "var desk = new SettingDesk(Mail(Scope.App));\n\ndesk.Set(\"mail.host\", \"mine.example.com\");\ndesk.Rebase(Mail(Scope.App, host: \"theirs.example.com\"));",
      "topic": "editing",
      "output": "conflict: True\ntheirs: theirs.example.com\nstill mine: mine.example.com"
    },
