@page "/packages/{Slug}"

@if (Entry is null)
{
    <PageTitle>@Text["notFound.title"]</PageTitle>

    <div class="page">
        <section class="not-found-page">
            <PageCrumbs Items="MissingCrumbs" />
            <h1>@Text["package.missingTitle"]</h1>
            <p>@Text["package.missingText"]</p>
            <a class="return-link" href="@($"{Navigation.BaseUri}#packages")">@Text["package.back"]</a>
            <h2>@Text["notFound.packages"]</h2>
            <PackageLinks Items="LibraryCatalog.Entries" />
        </section>
    </div>
}
else
{
    <PageTitle>@PageTitle</PageTitle>

    <div class="page">
        <div class="doc-grid">
            <div class="doc-rail">
                <div class="rail-sticky">
                    <PackageIndex Current="Entry" />
                </div>
            </div>

            <article class="doc-main">
                <PageCrumbs Items="Crumbs" />

                <OSPageHead Class="page-head" Title="@Text[Entry.TextKey("title")]">
                    <SubtitleContent>
                        <OSInlineText Text="@Text[Entry.TextKey("summary")]" />
                    </SubtitleContent>
                    <Details>
                        <OSHeadItem Label="@Text["package.name"]">
                            <code>@Entry.Name</code>
                        </OSHeadItem>
                        @if (GroupName is { } group)
                        {
                            <OSHeadItem Label="@Text["package.group"]">
                                <span>@group</span>
                            </OSHeadItem>
                        }
                        <OSHeadItem Label="@Text["package.guides"]">
                            <span>@GuidesCount</span>
                        </OSHeadItem>
                    </Details>
                </OSPageHead>

                <MobileDocNav Entry="Entry" Sections="SectionLinks" />

                <DocSection Id="overview" Index="1" Title="@Text["package.sections.overview"]">
                    @if (Gives.Count == 0)
                    {
                        <p class="doc-note">@Text["package.overviewNone"]</p>
                    }
                    else
                    {
                        <ul class="gives">
                            @foreach (var give in Gives)
                            {
                                <li><OSInlineText Text="@give" /></li>
                            }
                        </ul>
                    }
                </DocSection>

                <DocSection Id="install" Index="2" Title="@Text["package.sections.install"]">
                    <div class="command" dir="ltr">
                        <code>@InstallCommand</code>
                        <OSTooltip Text="@Text["code.copyCommand"]" Side="TooltipSide.Bottom">
                            <OSCopyButton Text="@InstallCommand" Label="@Text["code.copyCommand"]" DoneLabel="@Text["code.copied"]" />
                        </OSTooltip>
                    </div>
                    <p class="doc-note">@Text["package.installNote"]</p>

                    <h3 class="doc-h3">@Text["package.path"]</h3>
                    <DependencyPath Steps="Chain" />
                </DocSection>

                <DocSection Id="quick-start" Index="3" Title="@Text["package.sections.quickStart"]">
                    @if (!Entry.Samples.Any())
                    {
                        <p class="doc-note">@Text["package.quickStartNone"]</p>
                    }

                    @foreach (var sample in Entry.Samples)
                    {
                        <div class="sample">
                            <h3 class="doc-h3">@Text[Entry.TextKey($"sample.{sample.Key}")]</h3>
                            <OSCodeBlock Code="@sample.Code"
                                         Language="@sample.Language"
                                         Output="@sample.Output"
                                         CopyLabel="@Text["code.copy"]"
                                         CopiedLabel="@Text["code.copied"]"
                                         OutputLabel="@Text["code.output"]" />
                        </div>
                    }
                </DocSection>

                <DocSection Id="guides" Index="4" Title="@Text["package.sections.guides"]">
                    @if (Entry.Topics.Count == 0)
                    {
                        <p class="doc-note">@Text["package.guidesNone"]</p>
                    }
                    else
                    {
                        <ul class="guide-list">
                            @for (var i = 0; i < Entry.Topics.Count; i++)
                            {
                                var topic = Entry.Topics[i];
                                <li>
                                    <a class="guide-row" href="@($"{Navigation.BaseUri}{Entry.TopicRoute(topic)}")">
                                        <span class="guide-head">
                                            <span class="guide-no" aria-hidden="true">@Number(i + 1)</span>
                                            <span class="guide-title">@Text[Entry.TopicKey(topic, "title")]</span>
                                        </span>
                                        <span class="guide-summary">@Text[Entry.TopicKey(topic, "summary")]</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </DocSection>

                <DocSection Id="api" Index="5" Title="@Text["package.sections.api"]">
                    @if (ApiGroups.Count == 0)
                    {
                        <p class="doc-note">@Text["package.apiNone"]</p>
                    }
                    else
                    {
                        <p class="doc-note">@Text["package.apiNote"]</p>
                        <div class="type-groups">
                            @foreach (var group in ApiGroups)
                            {
                                <section class="type-group" aria-label="@Text[Entry.TopicKey(group.Topic, "title")]">
                                    <h3>@Text[Entry.TopicKey(group.Topic, "title")]</h3>
                                    <ul class="type-list">
                                        @foreach (var type in group.Types)
                                        {
                                            <li>
                                                <a href="@($"{Navigation.BaseUri}{Entry.TopicRoute(group.Topic)}")"><code>@TypeName(type)</code></a>
                                            </li>
                                        }
                                    </ul>
                                </section>
                            }
                        </div>
                    }
                </DocSection>

                <div class="doc-related">
                    <RelatedPackages Entry="Entry" />
                </div>

                <div class="doc-end">
                    <a class="return-link" href="@($"{Navigation.BaseUri}#packages")">@Text["nav.allPackages"]</a>
                </div>
            </article>

            <DocAside Sections="SectionLinks">
                <a class="aside-link" href="@($"{Navigation.BaseUri}#packages")">@Text["nav.allPackages"]</a>

                <section class="aside-block">
                    <p class="aside-title">@Text["topic.list"]</p>
                    <ul class="aside-list">
                        @foreach (var topic in Entry.Topics)
                        {
                            <li>
                                <a href="@($"{Navigation.BaseUri}{Entry.TopicRoute(topic)}")">@Text[Entry.TopicKey(topic, "title")]</a>
                            </li>
                        }
                    </ul>
                </section>

                <section class="aside-block">
                    <p class="aside-title">@Text["package.name"]</p>
                    <dl class="aside-facts">
                        <div>
                            <dt>@Text["package.version"]</dt>
                            <dd>@Entry.Version</dd>
                        </div>
                        <div>
                            <dt>@Text["package.dependsOn"]</dt>
                            <dd>@Number(DependsCount)</dd>
                        </div>
                        <div>
                            <dt>@Text["package.usedBy"]</dt>
                            <dd>@Number(UsedByCount)</dd>
                        </div>
                    </dl>
                </section>

                <section class="aside-block">
                    <p class="aside-title">@Text["related.title"]</p>
                    <RelatedPackages Entry="Entry" />
                </section>
            </DocAside>
        </div>
    </div>
}
