@page "/not-found"
@layout MainLayout

<PageTitle>@Text["notFound.title"]</PageTitle>

<div class="page">
    <section class="not-found-page">
        <PageCrumbs Items="Crumbs" />
        <h1>@Text["notFound.heading"]</h1>
        <p class="not-found-code" dir="ltr">404</p>
        <p>@Text["notFound.description"]</p>
        <OSButton Kind="ButtonKind.Key" Href="@Navigation.BaseUri">@Text["notFound.return"]</OSButton>
        <h2>@Text["notFound.packages"]</h2>
        <PackageLinks Items="LibraryCatalog.Entries" />
    </section>
</div>
