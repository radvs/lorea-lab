@page "/packages/{Slug}/{TopicSlug}"

@if (Entry is null || Current is null)
{
    <PageTitle>@Text["notFound.title"]</PageTitle>

    <div class="page">
        <section class="not-found-page">
            <PageCrumbs Items="MissingCrumbs" />
            <h1>@Text["topic.missingTitle"]</h1>
            <p>@Text["topic.missingText"]</p>
            <a class="return-link" href="@($"{Navigation.BaseUri}#packages")">@Text["package.back"]</a>
            <h2>@Text["notFound.packages"]</h2>
            <PackageLinks Items="LibraryCatalog.Entries" />
        </section>
    </div>
}
else
{
    <PageTitle>@PageTitle</PageTitle>

    <div class="page">
        <div class="doc-grid">
            <div class="doc-rail">
                <div class="rail-sticky">
                    <TopicIndex Entry="Entry" Current="Current" />
                </div>
            </div>

            <article class="doc-main">
                <PageCrumbs Items="Crumbs" />

                <OSPageHead Class="page-head" Title="@Title" Subtitle="@Text[Key("summary")]">
                    <Details>
                        <OSHeadItem Label="@Text["package.name"]">
                            <a href="@PackageUrl"><code>@Entry.Name</code></a>
                        </OSHeadItem>
                        @if (ShowNamespaces)
                        {
                            <OSHeadItem Label="@Text["topic.namespaces"]">
                                <code dir="ltr">@(string.Join(", ", Current.Namespaces))</code>
                            </OSHeadItem>
                        }
                    </Details>
                </OSPageHead>

                <PageTocStrip Sections="SectionLinks" />

                <MobileDocNav Entry="Entry" Current="Current" Sections="SectionLinks" />

                <DocSection Id="glance" Index="1" Title="@Text["topic.glance"]">
                    @if (Points.Count > 0)
                    {
                        <div class="glance">
                            @foreach (var point in Points)
                            {
                                <div class="glance-item">
                                    <b>@point.Title</b>
                                    <span><OSInlineText Text="@point.Text" /></span>
                                </div>
                            }
                        </div>
                    }
                    else if (About is { } about)
                    {
                        <p class="doc-lead"><OSInlineText Text="@about" /></p>
                    }
                    else
                    {
                        <p class="doc-note">@Text["topic.glanceNone"]</p>
                    }
                </DocSection>

                <DocSection Id="samples" Index="2" Title="@Text["topic.samples"]">
                    @if (!Samples.Any())
                    {
                        <p class="doc-note">@Text["topic.samplesNone"]</p>
                    }

                    @foreach (var sample in Samples)
                    {
                        <div class="sample">
                            <h3 class="doc-h3">@Text[Key($"sample.{sample.Key}.title")]</h3>
                            @if (Note($"sample.{sample.Key}.note") is { } note)
                            {
                                <p class="doc-note"><OSInlineText Text="@note" /></p>
                            }
                            <OSCodeBlock Code="@sample.Code"
                                         Language="@sample.Language"
                                         Output="@sample.Output"
                                         CopyLabel="@Text["code.copy"]"
                                         CopiedLabel="@Text["code.copied"]"
                                         OutputLabel="@Text["code.output"]" />
                        </div>
                    }
                </DocSection>

                <DocSection Id="details" Index="3" Title="@Text["topic.details"]">
                    @if (Parts.Count == 0)
                    {
                        <p class="doc-note">@Text["topic.detailsNone"]</p>
                    }
                    else
                    {
                        <OSAccordion Class="parts" Multiple="true" OpenId="part-1">
                            @for (var i = 0; i < Parts.Count; i++)
                            {
                                var part = Parts[i];
                                <OSAccordionItem Id="@($"part-{i + 1}")" Title="@part.Title">
                                    <ChildContent>
                                        @foreach (var paragraph in part.Text.Split("\n\n"))
                                        {
                                            <p><OSInlineText Text="@paragraph" /></p>
                                        }
                                    </ChildContent>
                                </OSAccordionItem>
                            }
                        </OSAccordion>
                    }
                </DocSection>

                <DocSection Id="api" Index="4" Title="@Text["topic.api"]">
                    @if (Types.Count == 0)
                    {
                        <p class="doc-note">@Text["topic.apiNone"]</p>
                    }
                    else
                    {
                        <OSAccordion Class="api-list">
                            @foreach (var type in Types)
                            {
                                var noted = type.Members.Any(member => MemberNote(type, member) is not null || member.Obsolete is not null);
                                <OSAccordionItem Id="@($"api-{type.Key}")" Padded="false">
                                    <TitleContent>
                                        <code class="api-signature" dir="ltr">@type.Signature</code>
                                        @if (Note($"type.{type.Key}") is { } typeNote)
                                        {
                                            <span class="api-type-note"><OSInlineText Text="@typeNote" /></span>
                                        }
                                    </TitleContent>
                                    <ChildContent>
                                        @if (type.Obsolete is not null)
                                        {
                                            <p class="api-obsolete">@Text["topic.obsolete"] <bdi dir="auto">@type.Obsolete</bdi></p>
                                        }
                                        @if (type.Members.Count > 0)
                                        {
                                            <table class="api-reference" data-noted="@(noted ? "true" : "false")">
                                                <thead>
                                                    <tr>
                                                        <th scope="col">@Text["topic.columnMember"]</th>
                                                        @if (noted)
                                                        {
                                                            <th scope="col">@Text["topic.columnText"]</th>
                                                        }
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var member in type.Members)
                                                    {
                                                        <tr>
                                                            <th scope="row">
                                                                @foreach (var signature in member.Signatures)
                                                                {
                                                                    <code dir="ltr">@signature</code>
                                                                }
                                                            </th>
                                                            @if (noted)
                                                            {
                                                                <td>
                                                                    <OSInlineText Text="@MemberNote(type, member)" />
                                                                    @if (member.Obsolete is not null)
                                                                    {
                                                                        <span class="api-obsolete">@Text["topic.obsolete"] <bdi dir="auto">@member.Obsolete</bdi></span>
                                                                    }
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                    </ChildContent>
                                </OSAccordionItem>
                            }
                        </OSAccordion>
                    }
                </DocSection>

                <PageSteps Previous="PreviousStep" Next="NextStep" />

                <div class="doc-related">
                    <RelatedPackages Entry="Entry" />
                </div>

                <div class="doc-end">
                    <a class="return-link" href="@PackageUrl">@Text["topic.back"]</a>
                </div>
            </article>
        </div>
    </div>
}
